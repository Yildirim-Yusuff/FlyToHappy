            </div>

            <!-- KURUMSAL -->
            <div class="fly-footer-column">
                <div class="fly-footer-title">Kurumsal</div>

                <ul class="fly-footer-links">
                    <li><a href="#" class="fly-footer-link">Hakkımızda</a></li>
