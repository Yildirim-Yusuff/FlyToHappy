                            <path d="M31 8.3l0.9 2.1 2.1 0.9-2.1 0.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1Z"
                                  fill="#fff" />
                        </svg>

                        <span class="brand-name">
                            FlyTo<em>Happy</em>
