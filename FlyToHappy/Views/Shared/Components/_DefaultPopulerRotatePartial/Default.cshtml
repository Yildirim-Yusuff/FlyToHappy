<style>
    .popular-flight-section {
        padding: 85px 0;
    }

    .popular-flight-head {
        margin-bottom: 30px;
    }

    .popular-flight-eyebrow {
        display: block;
        margin-bottom: 6px;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--accent, #ff6a3d);
    }

    /* SLIDER DIŞ ALANI */
    .popular-flight-slider {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 10px 0 22px;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .popular-flight-slider::-webkit-scrollbar {
            display: none;
        }

    /* KARTLARIN AKTIĞI ALAN */
    .popular-flight-grid {
        display: flex;
        gap: 18px;
        width: max-content;
    }

        .popular-flight-grid::-webkit-scrollbar {
            display: none;
        }

    /* KAMPANYA KARTI */
    .popular-flight-card {
        flex: 0 0 210px;
        width: 210px;
        min-width: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        padding: 0;
        border-radius: 18px;
        text-decoration: none;
        color: var(--text, #fff);
        background: var(--glass-bg, rgba(255,255,255,.08));
        border: 1px solid var(--glass-border, rgba(255,255,255,.18));
        box-shadow: var(--glass-shadow, 0 10px 30px rgba(0,0,0,.25));
        -webkit-backdrop-filter: blur(var(--blur, 14px));
        backdrop-filter: blur(var(--blur, 14px));
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .popular-flight-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 40px rgba(0,0,0,.35);
        }

    /* KART GÖRSELİ */
    .popular-flight-image {
        height: 150px;
        overflow: hidden;
    }

        .popular-flight-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .3s ease;
        }

    .popular-flight-card:hover .popular-flight-image img {
        transform: scale(1.05);
    }

    /* KART İÇERİĞİ */
    .popular-flight-body {
        min-height: 155px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 6px;
        padding: 16px;
    }

    .popular-flight-route {
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.3;
        color: var(--text, #fff);
    }

        .popular-flight-route span {
            margin: 0 3px;
            color: var(--accent-2, #ffb020);
        }

    .popular-flight-date {
        font-size: .76rem;
        line-height: 1.4;
        color: var(--text-dim, rgba(255,255,255,.7));
    }

    .popular-flight-fare {
        margin-top: auto;
        padding-top: 10px;
    }

    .popular-flight-note {
        margin-bottom: 3px;
        font-size: .72rem;
        color: var(--text-dim, rgba(255,255,255,.7));
    }

    .popular-flight-price {
        font-size: 1.12rem;
        font-weight: 800;
        color: var(--accent-2, #ffb020);
    }

    /* TABLET */
    @@media (max-width: 992px) {
        .popular-flight-card {
            flex: 0 0 200px;
            width: 200px;
        }

        .popular-flight-image {
            height: 140px;
        }
    }

    /* MOBİL */
    @@media (max-width: 576px) {
        .popular-flight-section {
            padding: 60px 0;
        }

        .popular-flight-card {
            flex: 0 0 180px;
            width: 180px;
        }

        .popular-flight-image {
            height: 125px;
        }

        .popular-flight-body {
            min-height: 145px;
            padding: 12px;
        }

        .popular-flight-route {
            font-size: .9rem;
        }

        .popular-flight-date {
            font-size: .7rem;
        }

        .popular-flight-price {
            font-size: 1rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .popular-flight-card,
        .popular-flight-image img {
            transition: none;
        }
    }
</style>

