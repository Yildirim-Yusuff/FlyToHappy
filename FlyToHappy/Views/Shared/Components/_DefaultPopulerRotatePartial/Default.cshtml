<script>
    (function () {
        const section = document.querySelector("#popularFlights");

        if (!section) return;

        const slider = section.querySelector(".popular-flight-slider");
        const track = section.querySelector(".popular-flight-grid");

        if (!slider || !track) return;

        const cards = Array.from(
            track.querySelectorAll(".popular-flight-card")
        );

        if (!cards.length) return;

        /* KARTLARIN KOPYASINI SONA EKLE */
        cards.forEach(function (card) {
            const clone = card.cloneNode(true);

            clone.setAttribute("aria-hidden", "true");
            clone.setAttribute("tabindex", "-1");

            track.appendChild(clone);
        });

        let groupWidth = 0;
        let position = 0;
        let paused = false;
        let lastTime = null;

        /* HAREKET HIZI */
        const speed = 40;

        function calculateWidth() {
            const allCards =
                track.querySelectorAll(".popular-flight-card");

            const firstCard = allCards[0];
            const firstClone = allCards[cards.length];

            groupWidth =
                firstClone.offsetLeft -
                firstCard.offsetLeft;

            /*
                İkinci grubun başından başlatıyoruz.
                Böylece kartlar görsel olarak sağa doğru akar.
            */
            position = groupWidth;

            slider.scrollLeft = position;
        }

        function animate(time) {
            if (lastTime === null) {
                lastTime = time;
            }

            const delta =
                (time - lastTime) / 1000;

            lastTime = time;

            if (!paused && groupWidth > 0) {
                position -= speed * delta;

                /*
                    Baştaki gruba geldiğimizde
                    görünmeden tekrar ikinci gruba geç.
                */
                if (position <= 0) {
                    position += groupWidth;
                }

                slider.scrollLeft = position;
            }

            requestAnimationFrame(animate);
        }

        /* MOUSE GELİNCE DUR */
        slider.addEventListener("mouseenter", function () {
            paused = true;
        });

        /* MOUSE ÇIKINCA DEVAM */
        slider.addEventListener("mouseleave", function () {
            paused = false;
            lastTime = null;
        });

        /* MOBİL DOKUNMA */
        slider.addEventListener(
            "touchstart",
            function () {
                paused = true;
            },
            { passive: true }
        );

        slider.addEventListener(
            "touchend",
            function () {
                paused = false;
                lastTime = null;
            },
            { passive: true }
        );

        /* EKRAN BOYUTU DEĞİŞİRSE */
        window.addEventListener("resize", function () {
            calculateWidth();
            lastTime = null;
        });

        /* BAŞLAT */
        requestAnimationFrame(function () {
            calculateWidth();
            requestAnimationFrame(animate);
        });
    })();
</script>