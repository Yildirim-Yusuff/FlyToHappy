<style>
    .destination-section {
        width: 100%;
        padding: 65px 16px;
    }

    .destination-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* BAŞLIK */
    .destination-head {
        text-align: center;
        margin-bottom: 28px;
    }

    .destination-eyebrow {
        display: block;
        margin-bottom: 7px;
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .14em;
        color: var(--accent, #ff6a3d);
        text-transform: uppercase;
    }

    .destination-title {
        margin: 0;
        font-size: clamp(1.7rem, 3vw, 2.5rem);
        font-weight: 800;
        color: var(--text, #fff);
        line-height: 1.2;
    }

    .destination-subtitle {
        max-width: 650px;
        margin: 10px auto 0;
        font-size: .9rem;
        line-height: 1.6;
        color: var(--text-dim, rgba(255,255,255,.75));
    }

    /* ANA GLASS PANEL */
    .destination-panel {
        padding: 22px;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 22px;
        background: rgba(28,32,46,.28);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 14px 35px rgba(0,0,0,.15);
    }

    /* ÜLKE / BÖLGE SEKMELERİ */
    .destination-tabs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        max-width: 650px;
        margin: 0 auto 28px;
        padding: 5px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 14px;
        background: rgba(255,255,255,.05);
    }

    .destination-tab {
        border: none;
        border-radius: 10px;
        padding: 10px 14px;
        background: transparent;
        color: var(--text-dim, rgba(255,255,255,.72));
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .25s ease, color .25s ease, transform .25s ease;
    }

        .destination-tab:hover {
            color: #fff;
            transform: translateY(-1px);
        }

        .destination-tab.active {
            color: #fff;
            background: linear-gradient( 135deg, var(--accent, #ff6a3d), var(--accent-2, #ffb020) );
            box-shadow: 0 6px 16px rgba(255,106,61,.18);
        }

    /* İÇERİK */
    .destination-pane {
        display: none;
    }

        .destination-pane.active {
            display: block;
            animation: destinationFade .3s ease;
        }

    @@keyframes destinationFade {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* 5 SÜTUN */
    .destination-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px 32px;
    }

    .destination-link {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        padding: 7px 5px;
        border-radius: 8px;
        color: var(--text-dim, rgba(255,255,255,.75));
        text-decoration: none;
        font-size: .82rem;
        font-weight: 500;
        transition: color .2s ease, transform .2s ease, background .2s ease;
    }

        .destination-link i {
            flex-shrink: 0;
            font-size: .95rem;
            color: var(--accent-2, #ffb020);
        }

        .destination-link:hover {
            color: #fff;
            background: rgba(255,255,255,.05);
            transform: translateX(4px);
        }

    /* TABLET */
    @@media (max-width: 992px) {
        .destination-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* MOBİL */
    @@media (max-width: 576px) {
        .destination-section {
            padding: 45px 14px;
        }

        .destination-panel {
            padding: 16px;
        }

        .destination-tabs {
            grid-template-columns: repeat(2, 1fr);
        }

        .destination-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 6px 12px;
        }

        .destination-link {
            font-size: .76rem;
        }
    }

    @@media (max-width: 400px) {
        .destination-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

