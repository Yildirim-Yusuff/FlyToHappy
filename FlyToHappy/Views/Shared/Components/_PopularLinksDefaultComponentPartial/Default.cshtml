<script>
    (function () {
        const section = document.querySelector("#popularDestinations");
        if (!section) return;

        const tabs = section.querySelectorAll(".destination-tab");
        const panes = section.querySelectorAll(".destination-pane");

        tabs.forEach(function (tab) {
            tab.addEventListener("click", function () {

                const target = this.dataset.destination;

                tabs.forEach(function (button) {
                    button.classList.remove("active");
                });

                panes.forEach(function (pane) {
                    pane.classList.remove("active");
                });

                this.classList.add("active");

                const activePane = section.querySelector(
                    '.destination-pane[data-pane="' + target + '"]'
                );

                if (activePane) {
                    activePane.classList.add("active");
                }
            });
        });
    })();
</script>